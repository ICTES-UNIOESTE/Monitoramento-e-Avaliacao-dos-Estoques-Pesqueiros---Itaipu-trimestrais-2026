################################################################################
# Função para gerar tabelas de preço ####
#
# Lógica:
#
# 1) Recebe uma coluna principal de preço.
#
# 2) Opcionalmente recebe:
#    - uma coluna de preço alternativo;
#    - uma lista de estoques que devem usar esse preço alternativo.
#
# 3) Para as tabelas de peixe processado:
#
#    Cascudo -> usa Porquinho
#    Armado  -> usa Porquinho
#
#    Todos os demais estoques -> usam Filé
#
################################################################################

gera_tabelas_preco <- function(
    dados,
    coluna_preco,
    arquivo_geral,
    arquivo_zona,
    coluna_preco_alternativo = NULL,
    estoques_alternativos = NULL
){
  
  Preco <- dados
  
  ###########################################################################
  # Preço principal
  ###########################################################################
  
  Preco$Preco_valor <- suppressWarnings(
    as.numeric(
      Preco[[coluna_preco]]
    )
  )
  
  ###########################################################################
  # Substituição por preço alternativo
  ###########################################################################
  
  if(
    !is.null(coluna_preco_alternativo) &&
    !is.null(estoques_alternativos)
  ){
    
    Preco$Preco_alternativo <- suppressWarnings(
      as.numeric(
        Preco[[coluna_preco_alternativo]]
      )
    )
    
    usar_alternativo <-
      Preco$Estoque %in% estoques_alternativos
    
    # Cascudo e Armado usam obrigatoriamente Porquinho
    Preco$Preco_valor[usar_alternativo] <-
      Preco$Preco_alternativo[usar_alternativo]
  }
  
  ###########################################################################
  # Filtragem dos dados válidos
  ###########################################################################
  
  Preco <- Preco[
    Preco$Preco_valor > 0 &
      !is.na(Preco$Preco_valor) &
      !is.na(Preco$Estoque) &
      trimws(Preco$Estoque) != "",
  ]
  
  ###########################################################################
  # Seleção das colunas
  ###########################################################################
  
  Preco <- Preco[
    ,
    c(
      "Zona",
      "Estoque",
      "Preco_valor"
    )
  ]
  
  colnames(Preco) <- c(
    "Zona",
    "Espécie",
    "Preço"
  )
  
  ###########################################################################
  # Ordem das zonas
  ###########################################################################
  
  Preco$Zona <- factor(
    Preco$Zona,
    levels = c(
      "Fluvial",
      "Transição",
      "Lacustre",
      "Montante"
    )
  )
  
  ############################################################################
  # Tabela geral por estoque
  ############################################################################
  
  overall_summary <- aggregate(
    Preço ~ Espécie,
    data = Preco,
    FUN = function(x){
      
      c(
        mean = mean(
          x,
          na.rm = TRUE
        ),
        sd = sd(
          x,
          na.rm = TRUE
        )
      )
      
    }
  )
  
  overall_summary$Zona <- "Geral"
  
  overall_summary <- as.data.frame(
    overall_summary
  )
  
  colnames(overall_summary) <- c(
    "Espécies",
    "Preço",
    "Zona"
  )
  
  overall_summary$Preço_mean <-
    overall_summary$Preço[, 1]
  
  overall_summary$Preço_sd <-
    overall_summary$Preço[, 2]
  
  overall_summary <-
    overall_summary[, -2]
  
  overall_summary <- overall_summary %>%
    arrange(Espécies)
  
  ###########################################################################
  # Salvar tabela geral
  ###########################################################################
  
  write.xlsx(
    overall_summary,
    file = arquivo_geral,
    rowNames = FALSE
  )
  
  ############################################################################
  # Tabela por zona e estoque
  ############################################################################
  
  zona_summary <- aggregate(
    Preço ~ Espécie + Zona,
    data = Preco,
    FUN = function(x){
      
      c(
        mean = mean(
          x,
          na.rm = TRUE
        ),
        sd = sd(
          x,
          na.rm = TRUE
        )
      )
      
    }
  )
  
  zona_summary <- zona_summary %>%
    arrange(Espécie)
  
  ###########################################################################
  # Completar todas as combinações de estoque e zona
  ###########################################################################
  
  complete_set <- expand.grid(
    Espécie = unique(
      zona_summary$Espécie
    ),
    Zona = c(
      "Fluvial",
      "Transição",
      "Lacustre",
      "Montante"
    )
  )
  
  zona_summary_complete <- merge(
    zona_summary,
    complete_set,
    by = c(
      "Espécie",
      "Zona"
    ),
    all = TRUE
  )
  
  ###########################################################################
  # Reordenar zonas
  ###########################################################################
  
  zona_summary_complete$Zona <- factor(
    zona_summary_complete$Zona,
    levels = c(
      "Fluvial",
      "Transição",
      "Lacustre",
      "Montante"
    )
  )
  
  zona_summary_complete <- zona_summary_complete %>%
    arrange(
      Espécie,
      Zona
    )
  
  ###########################################################################
  # Organizar colunas finais
  ###########################################################################
  
  colnames(zona_summary_complete) <- c(
    "Espécies",
    "Zona",
    "Preço"
  )
  
  zona_summary_complete$Preço_mean <-
    zona_summary_complete$Preço[, 1]
  
  zona_summary_complete$Preço_sd <-
    zona_summary_complete$Preço[, 2]
  
  zona_summary_complete <-
    zona_summary_complete[, -3]
  
  ###########################################################################
  # Salvar tabela por zona
  ###########################################################################
  
  write.xlsx(
    zona_summary_complete,
    file = arquivo_zona,
    rowNames = FALSE
  )
  
  ###########################################################################
  # Retorno
  ###########################################################################
  
  return(
    list(
      geral = overall_summary,
      zona = zona_summary_complete,
      dados_filtrados = Preco
    )
  )
}

