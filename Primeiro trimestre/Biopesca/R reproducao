parse_data_biopesca <- function(x) {

  if (inherits(x, "Date")) {
    return(x)
  }

  if (inherits(x, "POSIXct") || inherits(x, "POSIXt")) {
    return(as.Date(x))
  }

  if (is.numeric(x)) {
    return(as.Date(x, origin = "1899-12-30"))
  }

  x <- trimws(as.character(x))
  x[x == ""] <- NA

  # Tenta primeiro o formato reconhecido automaticamente
  data_convertida <- suppressWarnings(as.Date(x))

  # Tenta mês/dia/ano
  idx <- is.na(data_convertida) & !is.na(x)

  if (any(idx)) {
    data_convertida[idx] <- suppressWarnings(
      as.Date(x[idx], format = "%m/%d/%Y")
    )
  }

  # Tenta dia/mês/ano
  idx <- is.na(data_convertida) & !is.na(x)

  if (any(idx)) {
    data_convertida[idx] <- suppressWarnings(
      as.Date(x[idx], format = "%d/%m/%Y")
    )
  }

  data_convertida
}

normalizar_texto <- function(x) {

  x <- trimws(as.character(x))

  iconv(
    tolower(x),
    from = "UTF-8",
    to = "ASCII//TRANSLIT"
  )
}

padronizar_zona <- function(x) {

  x_norm <- normalizar_texto(x)

  case_when(
    x_norm == "fluvial"   ~ "Fluvial",
    x_norm == "transicao" ~ "Transição",
    x_norm == "lacustre"  ~ "Lacustre",
    x_norm == "montante"  ~ "Montante",
    TRUE                  ~ NA_character_
  )
}

species_title_full <- function(x) {

  x <- trimws(as.character(x))
  x <- gsub("_", " ", x)
  x <- gsub("\\s+", " ", x)

  x
}

safe_filename <- function(x) {

  x_safe <- iconv(
    as.character(x),
    from = "UTF-8",
    to = "ASCII//TRANSLIT"
  )

  if (is.na(x_safe)) {
    x_safe <- as.character(x)
  }

  x_safe <- gsub("[^A-Za-z0-9_ -]+", "", x_safe)
  x_safe <- gsub(" +", "_", x_safe)
  x_safe <- gsub("_+", "_", x_safe)
  x_safe <- gsub("^_|_$", "", x_safe)

  if (nchar(x_safe) == 0) {
    x_safe <- "sem_nome"
  }

  x_safe
}

# Calcula a frequência e o percentual de cada estágio por mês
make_month_stage_percent <- function(df, month_order) {

  df %>%
    mutate(
      Mes = as.character(Mes),
      Estagio = as.character(Estagio)
    ) %>%
    filter(
      !is.na(Mes),
      !is.na(Estagio),
      Mes %in% month_order,
      Estagio %in% stage_levels
    ) %>%
    count(Mes, Estagio, name = "n") %>%
    complete(
      Mes = month_order,
      Estagio = stage_levels,
      fill = list(n = 0)
    ) %>%
    mutate(
      Mes = factor(Mes, levels = month_order),
      Estagio = factor(Estagio, levels = stage_levels)
    ) %>%
    group_by(Mes) %>%
    mutate(
      total_mes = sum(n),
      pct = if_else(
        total_mes > 0,
        100 * n / total_mes,
        0
      ),
      pct = pmax(0, pmin(100, pct))
    ) %>%
    ungroup() %>%
    arrange(Mes, Estagio)
}

plot_month_stage_stack <- function(tab,
                                   titulo = "",
                                   italic_title = FALSE,
                                   title_hjust = 0.5) {

  ggplot(
    tab,
    aes(
      x = Mes,
      y = pct,
      fill = Estagio
    )
  ) +
    geom_col(width = 0.8) +
    labs(
      title = titulo,
      x = "Mês",
      y = "Percentual de registros (%)",
      fill = "Estágio"
    ) +
    scale_x_discrete(drop = FALSE) +
    scale_fill_manual(
      values = stage_colors,
      limits = stage_levels,
      breaks = stage_levels,
      drop = FALSE
    ) +
    scale_y_continuous(
      breaks = seq(0, 100, 10),
      expand = c(0, 0)
    ) +
    coord_cartesian(ylim = c(0, 100)) +
    theme_minimal(base_size = 14) +
    theme(
      panel.grid.major = element_blank(),
      panel.grid.minor = element_blank(),

      axis.line.x = element_line(
        color = "black",
        linewidth = 1
      ),
      axis.line.y = element_line(
        color = "black",
        linewidth = 1
      ),

      axis.title.x = element_text(
        size = axis_title_size,
        face = "plain"
      ),
      axis.title.y = element_text(
        size = axis_title_size,
        face = "plain"
      ),
      axis.text.x = element_text(
        size = axis_text_size,
        angle = 0,
        vjust = 0.5
      ),
      axis.text.y = element_text(
        size = axis_text_size
      ),

      legend.title = element_text(
        size = legend_title_size
      ),
      legend.text = element_text(
        size = legend_text_size
      ),

      plot.title = element_text(
        size = title_size,
        face = ifelse(
          italic_title,
          "italic",
          "plain"
        ),
        hjust = title_hjust
      ),
      plot.title.position = "plot",

      plot.background = element_rect(
        fill = "white",
        color = NA
      ),
      panel.background = element_rect(
        fill = "white",
        color = NA
      ),

      plot.margin = margin(
        t = 10,
        r = 25,
        b = 10,
        l = 10
      )
    )
}

