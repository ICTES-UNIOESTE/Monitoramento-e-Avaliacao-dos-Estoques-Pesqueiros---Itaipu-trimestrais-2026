rep_data <- BioTri26 %>%
  mutate(
    Zona = padronizar_zona(Zona),

    Espécie = trimws(as.character(Espécie)),
    especie_norm = normalizar_texto(Espécie),

    Data = parse_data_biopesca(Data),

    mes_num = as.integer(format(Data, "%m")),
    ano_num = format(Data, "%Y"),

    Mes = if_else(
      !is.na(mes_num) & !is.na(ano_num),
      paste0(mes_lbl[mes_num], " ", ano_num),
      NA_character_
    ),

    Mes_data = as.Date(format(Data, "%Y-%m-01")),

    Estagio = trimws(toupper(as.character(Estagio))),
    Estagio = na_if(Estagio, "")
  ) %>%
  mutate(
    Estagio = case_when(
      Estagio == "IMT" ~ "IMT",
      Estagio == "MAT" ~ "MAT",
      Estagio == "RPD" ~ "RPD",
      Estagio == "ESG" ~ "ESG",
      Estagio == "REG" ~ "REG",
      TRUE             ~ NA_character_
    )
  ) %>%
  filter(
    # Mantém somente as três zonas do reservatório
    Zona %in% zone_levels,

    # Exclui registros sem identificação de espécie
    !is.na(Espécie),
    Espécie != "",

    # Exclui as linhas de esforço sem captura
    especie_norm != "outros",

    # Mantém apenas registros úteis para a reprodução
    !is.na(Data),
    !is.na(Mes),
    !is.na(Estagio)
  )

