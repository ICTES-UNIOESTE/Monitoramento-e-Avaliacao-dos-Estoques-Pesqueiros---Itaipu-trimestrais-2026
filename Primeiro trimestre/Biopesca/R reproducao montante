    italic_title = TRUE,
    title_hjust = 0.5
  )
  
  ggsave(
    filename = file.path(out_dir, paste0("Reprodutivos_por_mes_MONTANTE_", sp_safe, ".png")),
    plot = p_sp,
    width = 12, height = 7, dpi = 300,
    bg = "white"
  )
}

